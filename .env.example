# =============================================================================
# SOC Detection Lab – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Splunk admin password (default shown – change before production use)
SPLUNK_PASSWORD=SocLab@2026

# Splunk HEC token – generate this inside Splunk UI after first boot:
#   Settings → Data Inputs → HTTP Event Collector → New Token
SPLUNK_HEC_TOKEN=changeme

# Alert webhook (Slack / Teams / PagerDuty incoming webhook URL)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/YOUR/WEBHOOK

# Alert email recipient
ALERT_EMAIL=security@company.com
