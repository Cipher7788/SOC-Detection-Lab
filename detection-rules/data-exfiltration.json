{
  "rule_name": "Data Exfiltration Detection",
  "description": "Detects potential data exfiltration activities based on anomalous outbound traffic volumes, unusual file transfers, and access to sensitive data repositories.",
  "version": "1.0",
  "severity": "critical",
  "mitre_attack": {
    "tactic": "Exfiltration",
    "technique": "T1048",
    "sub_technique": "T1048.003"
  },
  "detection": {
    "event_types": ["network_connection", "file_access", "dns_query", "http_request"],
    "rules": [
      {
        "id": "exfil_1",
        "description": "Anomalous outbound traffic volume",
        "condition": {
          "metric": "outbound_bytes",
          "operator": "greater_than",
          "threshold": "3x_daily_average",
          "time_window": "1h"
        },
        "severity": "high"
      },
      {
        "id": "exfil_2",
        "description": "Large file upload to external destination",
        "condition": {
          "direction": "outbound",
          "bytes_transferred": 104857600,
          "destination": "external",
          "protocol": ["HTTP", "HTTPS", "FTP", "SFTP"]
        },
        "severity": "critical"
      },
      {
        "id": "exfil_3",
        "description": "Sensitive file accessed by non-privileged user",
        "condition": {
          "file_path_contains": ["/finance/", "/hr/", "/confidential/", "PII", "passwords"],
          "user_role": "standard",
          "time_window": "30m"
        },
        "severity": "high"
      },
      {
        "id": "exfil_4",
        "description": "DNS tunneling indicators",
        "condition": {
          "dns_query_length": 100,
          "dns_query_frequency": 50,
          "time_window": "1m",
          "unusual_record_types": ["TXT", "NULL", "CNAME"]
        },
        "severity": "critical"
      },
      {
        "id": "exfil_5",
        "description": "Data staged in temp or user directories before exfil",
        "condition": {
          "file_path_contains": ["C:\\Users\\", "C:\\Temp\\", "/tmp/", "/var/tmp/"],
          "file_extension": [".zip", ".rar", ".7z", ".tar.gz"],
          "time_window": "2h"
        },
        "severity": "high"
      }
    ]
  },
  "splunk_query": "index=network dest_ip!=10.0.0.0/8 dest_ip!=192.168.0.0/16 dest_ip!=172.16.0.0/12 | stats sum(bytes_out) as total_bytes by src_ip, dest_ip | where total_bytes > 104857600 | sort -total_bytes",
  "response_actions": [
    {
      "action": "alert",
      "method": "email",
      "priority": 1,
      "description": "Notify security team and data owner"
    },
    {
      "action": "block_destination",
      "method": "firewall_rule",
      "priority": 2,
      "description": "Block outbound connection to suspicious destination"
    },
    {
      "action": "preserve_evidence",
      "method": "packet_capture",
      "priority": 3,
      "description": "Capture network traffic for forensic analysis"
    },
    {
      "action": "notify_dpo",
      "method": "compliance_workflow",
      "priority": 4,
      "description": "Notify Data Protection Officer for potential breach"
    }
  ],
  "false_positive_notes": "Whitelist approved cloud backup services, CDN upload endpoints, and known large-file transfer jobs during business hours.",
  "enabled": true,
  "created_at": "2026-03-10T00:00:00Z",
  "author": "Cipher7788"
}
